{
  "name": "pocket-travel-companion",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:h5",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "dev:h5": "uni -p h5",
    "build:h5": "uni build -p h5",
    "type-check": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "cross-env ESLINT_USE_FLAT_CONFIG=false eslint src --ext .vue,.ts,.tsx",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate:coverage-matrix": "node scripts/quality/validate-coverage.mjs",
    "deadcode:check": "knip",
    "deadcode:report": "knip --reporter json > deadcode-report.json"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5000820260420001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5000820260420001",
    "@dcloudio/uni-mp-weixin": "^3.0.0-alpha-5000820260420001",
    "pinia": "^2.1.7",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5000820260420001",
    "@types/node": "^25.6.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@vitest/coverage-v8": "^4.0.7",
    "@vue/compiler-sfc": "^3.4.21",
    "cross-env": "^10.1.0",
    "eslint": "^9.20.0",
    "eslint-plugin-vue": "^10.9.0",
    "knip": "^6.45.1",
    "sass": "^1.99.0",
    "typescript": "^5.7.3",
    "vite": "5.2.8",
    "vitest": "^4.0.7",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^2.2.0"
  }
}
