# Backend API environment template
# Copy this file to .env and adjust values for local development.

NODE_ENV=development
PORT=3000
ALLOW_START_WITHOUT_DB=true

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=pocket_travel_companion
# Optional: database used only when DB_NAME does not exist and the app needs to create it.
DB_BOOTSTRAP_DATABASE=postgres

# Auth
JWT_SECRET=change-me-in-local-env
JWT_EXPIRES_IN=7d

# WeChat integration
# Set true for local mock login flow.
WECHAT_MOCK=true
